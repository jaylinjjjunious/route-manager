# GEMINI_API_KEY: Required for Gemini AI API calls.
# Optional BlueAI receiver (server-only; see knowledge/features/blueai-ingestion.md).
# Require all three; BLUEAI_OWNER_ID must be a valid Supabase user UUID.
BLUEAI_INGEST_TOKEN=""
BLUEAI_OWNER_ID=""

# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps Platform services (Maps & Routes).
GOOGLE_MAPS_PLATFORM_KEY=""

# OPENAI_API_KEY: Optional. Required if using OpenAI realistic voice engine.
OPENAI_API_KEY=""

# ELEVENLABS_API_KEY: Optional. Required if using ElevenLabs realistic voice engine.
ELEVENLABS_API_KEY=""

# --- Supabase Auth ---
# VITE_SUPABASE_URL: Supabase project URL (public, used by browser).
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Supabase anonymous/public key (safe for browser with RLS).
VITE_SUPABASE_ANON_KEY=""

# Native bundled app backend (public HTTPS origin; web stays same-origin).
VITE_API_ORIGIN="https://route-manager-phtj.onrender.com"

# VITE_LOCAL_AUTH_BYPASS: Exposes the shield-logo login bypass only in local Vite development on a loopback hostname.
# This does not create a Supabase session or bypass protected backend APIs. Never enable it in shared environments.
VITE_LOCAL_AUTH_BYPASS=""

# VITE_ENABLE_SMART_AISLE_TEST_LAB: Enable Smart Aisle Scan Test Lab in local dev Developer Tools. Ignored by production builds.
# Set to "true" in dev/staging. Hidden in production by default.
VITE_ENABLE_SMART_AISLE_TEST_LAB=""

# SUPABASE_JWT_SECRET: Server-side JWT verification secret (NEVER expose to browser).
SUPABASE_JWT_SECRET=""

# SUPABASE_SERVICE_ROLE_KEY: Server-only service role key for BlueAI machine ingestion.
# NEVER expose to browser. Set in Render dashboard only.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Official Transit API (v4) ---
# TRANSIT_API_KEY: Server-side Transit API key (https://transitapp.com/api).
# MUST be kept server-side only. It is read from process.env by the backend
# proxy and must NEVER be prefixed with VITE_ (no browser exposure).
# Requires a plan with the "Transit" (v4) endpoint family.
TRANSIT_API_KEY=""

# TRANSIT_API_BASE_URL: Upstream base URL for the Transit v4 API.
TRANSIT_API_BASE_URL="https://external.transitapp.com/v4"

# TRANSIT_NETWORK_IDS: Default local agency network ids used for service
# alerts when location-based discovery is unavailable (GET for Bakersfield).
TRANSIT_NETWORK_IDS="GET|Bakersfield"

# VITE_TRANSIT_PROVIDER: Safe public flag that selects the Transit API provider
# in the browser. Does NOT contain or expose the API key. Set to "transit" to
# enable live stops, arrivals, alerts, and trip planning.
VITE_TRANSIT_PROVIDER=""
