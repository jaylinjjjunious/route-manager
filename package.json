{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vite build --config vite.config.standalone.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:habits": "node tests/habit-ui-check.cjs",
    "test:smart-aisle-lab": "node tests/smart-aisle-test-lab-ui-check.cjs",
    "verify": "node scripts/verify.cjs",
    "checkpoint": "node scripts/checkpoint.cjs",
    "release": "node scripts/release.cjs",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync ios",
    "cap:copy": "cap copy ios"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "8.5.3",
    "@cloudflare/vite-plugin": "1.63.1",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/postcss": "4.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/google.maps": "^3.65.2",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "6.0.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "0.21.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "2.4.0",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.5",
    "vinext": "1.1.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-rsc": "0.5.34",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "fflate": "0.7.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
