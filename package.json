{
  "name": "all-in-one",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/hallway",
    "apps/route-manager",
    "apps/cleaning"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env gateway/server.mjs --dev",
    "dev:hallway": "npm run dev --workspace @all-in-one/hallway",
    "dev:route-manager": "node --env-file-if-exists=.env scripts/run-route-manager.mjs --dev",
    "build": "npm run build --workspaces --if-present",
    "build:hallway": "npm run build --workspace @all-in-one/hallway",
    "build:route-manager": "npm run build --workspace @all-in-one/route-manager",
    "lint": "npm run lint --workspaces --if-present && node --check gateway/server.mjs && node --check gateway/router.mjs",
    "test": "npm run test --workspaces --if-present && node --test gateway/router.test.mjs",
    "start": "node --env-file-if-exists=.env gateway/server.mjs",
    "start:route-manager": "node --env-file-if-exists=.env scripts/run-route-manager.mjs",
    "start:hallway": "npm run preview --workspace @all-in-one/hallway",
    "verify": "node scripts/verify.cjs",
    "checkpoint": "node scripts/checkpoint.cjs",
    "release": "node scripts/release.cjs",
    "cap:add:ios": "npm run cap:add:ios --workspace @all-in-one/route-manager",
    "cap:sync": "npm run cap:sync --workspace @all-in-one/route-manager",
    "cap:copy": "npm run cap:copy --workspace @all-in-one/route-manager",
    "dev:cleaning": "npm run dev --workspace @all-in-one/cleaning",
    "build:cleaning": "npm run build --workspace @all-in-one/cleaning",
    "start:cleaning": "npm run preview --workspace @all-in-one/cleaning"
  },
  "overrides": {
    "fflate": "0.7.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
